    {
      "type": "timeseries",
      "title": "% de 5xx por hash de ReplicaSet",
      "id": 19,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Es lo que mide el AnalysisTemplate: umbral 5 %.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rollouts_pod_template_hash) (rate(app_http_requests_total{service=\"api-gateway\",route=~\"/api/.*\",status_class=\"5xx\"}[1m])) / sum by (rollouts_pod_template_hash) (rate(app_http_requests_total{service=\"api-gateway\",route=~\"/api/.*\"}[1m]))",
          "legendFormat": "{{rollouts_pod_template_hash}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
