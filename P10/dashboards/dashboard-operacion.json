        "h": 8,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "app_eventloop_delay_p99_seconds{service=~\"api-gateway|auth-service|reserva-service\"}",
          "legendFormat": "event loop p99 {{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (service, estado) (app_pg_pool_connections)",
