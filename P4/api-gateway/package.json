{
  "name": "api-gateway",
  "version": "1.0.0",
  "description": "API Gateway de CineTix, enruta hacia todos los microservicios",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "express": "5.2.1",
    "http-proxy-middleware": "^3.0.3",
    "dotenv": "^16.4.5",
    "cors": "^2.8.5",
    "cookie-parser": "^1.4.7",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "ts-node-dev": "^2.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/cors": "^2.8.17",
    "@types/cookie-parser": "^1.4.7",
    "@types/jsonwebtoken": "^9.0.7"
  }
}
